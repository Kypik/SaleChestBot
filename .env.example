TG_BOT_TOKEN=
VK_API_TOKEN=

# Необязательно. Заполни ОДНО из двух, если бот запускается там, где Telegram заблокирован.
# Свой прокси/VPN (локальный порт VPN-клиента или прокси на своём сервере):
# TG_PROXY=socks5://127.0.0.1:10808
# Свой адрес Bot API (зеркало):
# TG_API_URL=https://my-worker.example.workers.dev

# Telegram id админов через запятую (свой id бот покажет, если написать ему без доступа)
ADMIN_IDS=
